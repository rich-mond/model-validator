{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://model-validator.local/schemas/target.schema.json",
  "type": "object",
  "required": [ "schemaVersion", "targetId", "displayName", "agent", "model", "adapter", "environment", "limits" ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "targetId": { "type": "string", "minLength": 1 },
    "displayName": { "type": "string", "minLength": 1 },
    "agent": {
      "type": "object",
      "required": [ "name", "version" ],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "model": {
      "type": "object",
      "required": [ "name", "version", "provider" ],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "provider": { "type": "string", "minLength": 1 }
      }
    },
    "adapter": {
      "type": "object",
      "required": [ "mode", "image", "command", "workspacePath", "promptPath", "outputPath" ],
      "additionalProperties": false,
      "properties": {
        "mode": { "enum": [ "container", "process" ] },
        "image": { "type": [ "string", "null" ] },
        "command": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "workspacePath": { "type": "string", "minLength": 1 },
        "promptPath": { "type": "string", "minLength": 1 },
        "outputPath": { "type": "string", "minLength": 1 }
      }
    },
    "environment": {
      "type": "object",
      "required": [ "allowedVariables", "secretVariables" ],
      "additionalProperties": false,
      "properties": {
        "allowedVariables": { "type": "array", "items": { "type": "string" } },
        "secretVariables": { "type": "array", "items": { "type": "string" } }
      }
    },
    "limits": {
      "type": "object",
      "required": [ "cpuCount", "memoryBytes", "pids" ],
      "additionalProperties": false,
      "properties": {
        "cpuCount": { "type": "integer", "minimum": 1 },
        "memoryBytes": { "type": "integer", "minimum": 1 },
        "pids": { "type": "integer", "minimum": 1 }
      }
    },
    "hardware": {
      "type": [ "object", "null" ],
      "required": [ "os", "architecture", "processorCount", "totalMemoryBytes" ],
      "additionalProperties": false,
      "properties": {
        "os": { "type": "string" },
        "architecture": { "type": "string" },
        "processorCount": { "type": "integer" },
        "totalMemoryBytes": { "type": [ "integer", "null" ] }
      }
    }
  }
}
