{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://model-validator.local/schemas/benchmark-plan.schema.json",
  "type": "object",
  "required": [ "schemaVersion", "planId", "challengePath", "targets", "attemptsPerTarget", "outputPath", "execution" ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "planId": { "type": "string", "minLength": 1 },
    "challengePath": { "type": "string", "minLength": 1 },
    "targets": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "attemptsPerTarget": { "type": "integer", "minimum": 1 },
    "outputPath": { "type": "string", "minLength": 1 },
    "execution": {
      "type": "object",
      "required": [ "maximumParallelTargets", "retainWorkspaces" ],
      "additionalProperties": false,
      "properties": {
        "maximumParallelTargets": { "type": "integer", "minimum": 1 },
        "retainWorkspaces": { "type": "boolean" }
      }
    }
  }
}
